rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The FrictionForge Nightcrew architecture uses a Cloud Run service account
    // with the Firebase Admin SDK. The Admin SDK completely bypasses all security rules.
    // Therefore, we strictly deny all client-side read/write access to prevent 
    // unauthorized tampering with the shift log, tasks, or ledger.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
